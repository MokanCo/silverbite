# Public site URL used for canonical links, Open Graph, and the sitemap.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Shown in the footer when set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Required for the contact form to report success.
# The site POSTs JSON to this URL and only shows success after a 2xx response.
# Payload fields: name, email, company, phone, service, budget, message, source, submittedAt
CONTACT_WEBHOOK_URL=
